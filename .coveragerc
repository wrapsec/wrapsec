[run]
# The async DB layer runs on greenlet (the sync/async bridge). Without this,
# the line tracer drops coverage across every `await` into the DB, so async
# route handlers show almost fully uncovered even when tests exercise them.
concurrency = greenlet
source =
    api
    services
    engine
    db
    domain
    config
    cache
    workers
    security
    errors
    observability
    clients
omit =
    */__pycache__/*
    */tests/*
    db/migrations/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    @(abc\.)?abstractmethod
    ^\s*\.\.\.\s*$
sort = miss
