[run]
# The async DB layer runs on greenlet (the sync/async bridge). Without this,
# the line tracer drops coverage across every `await` into the DB, so async
# route handlers show almost fully uncovered even when tests exercise them.
concurrency = greenlet
branch = true
source =
    api
    services
    engine
    db
    domain
    config
    cache
    workers
    security
    errors
    observability
    clients
omit =
    */__pycache__/*
    */tests/*
    db/migrations/*

[report]
exclude_lines =
    pragma: no cover
    if TYPE_CHECKING:
    raise NotImplementedError
    if __name__ == .__main__.:
    @(abc\.)?abstractmethod
    ^\s*\.\.\.\s*$
sort = miss
# CI regression floor. `coverage report` exits non-zero below this, and the
# `make coverage` target runs under `set -e`, so CI fails on a real drop. Set a
# few points under the current branch-coverage level (~84-85%) so ordinary
# fluctuation does not flake the build; RATCHET UP as coverage improves -- never
# lower it to make a drop pass. The gap to 100% is un-unit-testable I/O (the LLM
# provider clients, the app lifespan, model-dependent detectors), deliberately
# kept in the denominator rather than omitted (an honest metric).
fail_under = 82
