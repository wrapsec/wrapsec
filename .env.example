# Application
APP_NAME=WrapSec
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
SECRET_KEY=your-secret-key-minimum-32-characters-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINS=60
ADMIN_API_KEY=your-admin-api-key-here

# Bootstrap first admin (optional — scripted/automated deploys only)
# If unset, the dashboard /setup page handles first-user creation on first visit.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql+asyncpg://wrapsec:wrapsec@localhost:5432/wrapsec
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Detection Engine
DEFAULT_DETECTION_MODE=fast
DEFAULT_EXECUTION_MODE=scan_only
BLOCK_THRESHOLD=0.7
SANITIZE_THRESHOLD=0.4
LLM_TRIGGER_THRESHOLD=0.2

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT=30

# Idempotency
IDEMPOTENCY_WINDOW_SECS=60

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
AUDIT_RETENTION_DAYS=30  # Days to keep audit logs in PostgreSQL

DATA_STORAGE_MODE=masked
DATA_RETENTION_DAYS_PROXY=7
