# Application
APP_NAME=WrapSec
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=development

# API
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# Security
SECRET_KEY=your-secret-key-minimum-32-characters-here
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINS=60
ADMIN_API_KEY=your-admin-api-key-minimum-32-chars-here

# CORS + refresh cookie Path
# CORS_ALLOWED_ORIGINS is a JSON list of Origins allowed to send credentialed
# requests (dashboard, browser extension). Empty list disables credentialed
# CORS entirely. Example:
#   CORS_ALLOWED_ORIGINS=["https://dashboard.example.com"]
# REFRESH_COOKIE_PATH is the default Path attribute for the refresh_token
# cookie. Direct callers (SDK, browser extension calling /v1/auth/*) need
# the default "/v1/auth". A BFF such as the dashboard fronts these routes
# under its own prefix and overrides per-request via X-Refresh-Cookie-Path
# (gated on Origin in CORS_ALLOWED_ORIGINS). If your only consumer is the
# dashboard container, you can flip the default to "/api/auth" here.
CORS_ALLOWED_ORIGINS=[]
REFRESH_COOKIE_PATH=/v1/auth

# BFF origin the dashboard container advertises to the backend so the backend
# recognises it as trusted and honors X-Refresh-Cookie-Path. Must equal one of
# the values in CORS_ALLOWED_ORIGINS. Example (production):
#   DASHBOARD_ORIGIN=https://dashboard.example.com
# Leave empty in single-host local dev if you don't need the dashboard's BFF
# path handshake (see REFRESH_COOKIE_PATH above).
DASHBOARD_ORIGIN=

# Bootstrap first admin (optional — scripted/automated deploys only)
# If unset, the dashboard /setup page handles first-user creation on first visit.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql+asyncpg://wrapsec:wrapsec@localhost:5432/wrapsec
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_TTL=3600

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Detection Engine
DEFAULT_DETECTION_MODE=fast
DEFAULT_EXECUTION_MODE=scan_only
BLOCK_THRESHOLD=0.7
SANITIZE_THRESHOLD=0.4
LLM_TRIGGER_THRESHOLD=0.2

# LLM Provider
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
GROQ_API_KEY=
LLM_TIMEOUT=30

# Idempotency
IDEMPOTENCY_WINDOW_SECS=60

# Observability
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
AUDIT_RETENTION_DAYS=30  # Days to keep audit logs in PostgreSQL

# OTLP export (optional). When set, start the collector with:
#   docker compose --profile otlp up -d
# The otel-collector service scrapes the existing /metrics endpoint and
# forwards to any OTLP-compatible backend. Env names follow the
# OpenTelemetry Protocol Exporter spec:
#   https://opentelemetry.io/docs/specs/otel/protocol/exporter/
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com:4317
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20xxxx
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc          # or http/protobuf
# OTEL_EXPORTER_OTLP_INSECURE=false          # true for self-signed / lab only

DATA_STORAGE_MODE=masked
DATA_RETENTION_DAYS_PROXY=7

# ── Production only ──────────────────────────────────────────────────────────
# Required when running ./setup.sh --prod

# Database password (replaces default 'wrapsec' in production)
# POSTGRES_PASSWORD=

# Redis password (no password by default — required in production)
# REDIS_PASSWORD=

# Grafana admin password. Required for prod. Must be >=12 chars and NOT a
# well-known weak value (admin, changeme, password, grafana, ...). setup.sh
# --prod rejects weak values before starting the container; docker compose
# also fails to interpolate if this is unset. Generate: openssl rand -base64 24
# GRAFANA_PASSWORD=

# SSL — optional. If both are set, Nginx serves HTTPS on port 443.
# Paths must be absolute paths on the host machine.
# Supports: Let's Encrypt certs, self-signed certs, or internal CA certs.
# SSL_CERT_PATH=
# SSL_KEY_PATH=

# Domain — optional. Used only when SSL is configured.
# DOMAIN=

# -- Webhook egress SSRF guard (v1.3.0+) --
# Outbound webhook/SIEM deliveries are locked down secure-by-default: the
# destination host is resolved at connect time and blocked if it maps to a
# private/loopback/link-local/metadata address, and https is required.
#
# This is SEPARATE from the LLM proxy target (LLM_PROVIDER / base_url), which
# is often an internal service (e.g. an in-cluster Ollama/vLLM) and is NOT
# restricted -- a self-hosted gateway in front of an internal LLM keeps working
# with no config here.
#
# To send webhooks to an on-prem SIEM on a private address, allowlist its host
# or CIDR (comma-separated). Leave empty to block all internal targets.
# WEBHOOK_EGRESS_ALLOWLIST=splunk.internal,10.20.0.0/16
#
# Set to false to allow private webhook targets on a fully trusted network
# (disables the resolve-time block entirely). Default: true.
# WEBHOOK_BLOCK_PRIVATE_EGRESS=true
#
# Require https for webhook destinations. Default: true. Allowlisted hosts may
# use http regardless.
# WEBHOOK_REQUIRE_HTTPS=true

# Email (transactional security notifications)
# Optional. With no SMTP_HOST the app boots normally and email is disabled:
# notifications are enqueued but not delivered. Set SMTP_USE_TLS=true for
# implicit TLS (port 465) OR SMTP_START_TLS=true for STARTTLS (port 587), not
# both. SMTP_FROM is required once SMTP_HOST is set.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_USE_TLS=false
# SMTP_START_TLS=true
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=WrapSec
# SMTP_TIMEOUT_SECONDS=15
# Delivery worker + retention (defaults shown).
# EMAIL_WORKER_ENABLED=true
# EMAIL_WORKER_POLL_SECONDS=10
# EMAIL_WORKER_BATCH=20
# EMAIL_WORKER_CONCURRENCY=5
# EMAIL_RETENTION_DAYS=30
